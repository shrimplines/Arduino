#include <Servo.h>

// pins
const int SPIN_BUTTON = 5;
const int BLINK_BUTTON = 3;
const int SPIN_SERVO_PIN = 10;
const int BLINK_SERVO_PIN = 11;

// objects
Servo spinServo;
Servo blinkServo;

// state
int lastSpinState = HIGH;
int lastBlinkState = HIGH;
bool spinSequenceActive = false;
bool blinkSequenceActive = false;

void setup() {
  Serial.begin(9600);
  
  spinServo.attach(SPIN_SERVO_PIN);
  blinkServo.attach(BLINK_SERVO_PIN);
  
  spinServo.write(0);
  blinkServo.write(0);
  
  pinMode(SPIN_BUTTON, INPUT_PULLUP);
  pinMode(BLINK_BUTTON, INPUT_PULLUP);
  
  Serial.println("Ready! Press button 5 for Spin, button 3 for Blink");
  Serial.println("Spin servo on pin 6 | Blink servo on pin 11");
}

void loop() {
  // spin check
  int currentSpinState = digitalRead(SPIN_BUTTON);
  
  if (lastSpinState == HIGH && currentSpinState == LOW && !spinSequenceActive && !blinkSequenceActive) {
    spinSequenceActive = true;
    Serial.println("Starting Spin Sequence");
  }
  lastSpinState = currentSpinState;
  
  // blink check
  int currentBlinkState = digitalRead(BLINK_BUTTON);
  
  if (lastBlinkState == HIGH && currentBlinkState == LOW && !blinkSequenceActive && !spinSequenceActive) {
    blinkSequenceActive = true;
    Serial.println("Starting Blink Sequence");
  }
  lastBlinkState = currentBlinkState;
  
  // run
  if (spinSequenceActive) {
    runSpinSequence();
    spinSequenceActive = false;
    Serial.println("Spin Sequence Complete");
  }
  
  if (blinkSequenceActive) {
    runBlinkSequence();
    blinkSequenceActive = false;
    Serial.println("Blink Sequence Complete");
  }
}

// spin seq
void runSpinSequence() {
  smoothMove(spinServo, 30, 2000);
  delay(750);
  smoothMove(spinServo, -30, 4000);
  delay(750);
  smoothMove(spinServo, 0, 2000);
}

// blink seq
void runBlinkSequence() {
  smoothMove(blinkServo, 100, 2000);
  delay(750);
  smoothMove(blinkServo, 0, 2000);
}

// move helper
void smoothMove(Servo &servo, int targetAngle, int durationMs) {
  int startAngle = servo.read();
  int degreesToMove = targetAngle - startAngle;
  
  if (degreesToMove == 0) return;
  
  int delayPerDegree = durationMs / abs(degreesToMove);
  if (delayPerDegree < 15) delayPerDegree = 15;
  
  if (degreesToMove > 0) {
    for (int angle = startAngle; angle <= targetAngle; angle++) {
      servo.write(angle);
      delay(delayPerDegree);
    }
  } else {
    for (int angle = startAngle; angle >= targetAngle; angle--) {
      servo.write(angle);
      delay(delayPerDegree);
    }
  }
}

// ============
// pacman timer
// ============

#include <Wire.h> 
#include <LiquidCrystal_I2C.h>

// pin config
LiquidCrystal_I2C lcd(0x27, 16, 2);

const int potPin = A2;
const int startBtn = 4;
const int resetBtn = 5;
const int buzzerPin = 3; 

// characters
byte pacOpen[8] = {0b00000, 0b01110, 0b11111, 0b11100, 0b11111, 0b01110, 0b00000, 0b00000};
byte pacClosed[8] = {0b00000, 0b01110, 0b11111, 0b11111, 0b11111, 0b01110, 0b00000, 0b00000};
byte dot[8] = {0b00000, 0b00000, 0b00000, 0b01100, 0b01100, 0b00000, 0b00000, 0b00000};
byte ghost[8] = {0b01110, 0b11111, 0b10101, 0b11111, 0b11111, 0b11111, 0b10101, 0b00000};
byte dead[8] = {0b00000, 0b00000, 0b00000, 0b00000, 0b00000, 0b11111, 0b00000, 0b00000};

// variables
long timerSeconds = 0;
long initialSeconds = 0; 
bool running = false;
bool isReset = true; 
unsigned long lastTick = 0;
bool mouthOpen = true;

// setup
void setup() {
  lcd.init();
  lcd.backlight();
  lcd.createChar(0, pacOpen);
  lcd.createChar(1, pacClosed);
  lcd.createChar(2, dot);
  lcd.createChar(3, ghost);
  lcd.createChar(4, dead);
  
  pinMode(startBtn, INPUT_PULLUP);
  pinMode(resetBtn, INPUT_PULLUP);
  pinMode(buzzerPin, OUTPUT);
}

// main
void loop() {
  // button logic
  if (digitalRead(startBtn) == LOW) {
    if (timerSeconds > 0) {
      if (isReset) initialSeconds = timerSeconds; 
      running = !running;
      isReset = false;
      lcd.clear();
      delay(300);
    }
  }

  if (digitalRead(resetBtn) == LOW) {
    running = false;
    isReset = true;
    timerSeconds = 0;
    lcd.clear();
    delay(300);
  }

  // modes
  if (!running && isReset) {
    // START MODE (SETTING)
    int potVal = analogRead(potPin);
    int steps = map(potVal, 0, 1023, 0, 60); 
    timerSeconds = (long)steps * 30;
    
    lcd.setCursor(0, 0);
    lcd.print("START: "); 
    printPaddedTime(timerSeconds);
    
    lcd.setCursor(0, 1);
    lcd.write(0); 
    for(int i=1; i<15; i++) lcd.write(2); 
    lcd.write(3); 
  } 
  else if (running && timerSeconds > 0) {
    // MUNCH MODE (ACTIVE)
    if (millis() - lastTick >= 1000) {
      timerSeconds--;
      lastTick = millis();
      mouthOpen = !mouthOpen;
      
      lcd.setCursor(0, 0);
      lcd.print("GO: "); 
      printPaddedTime(timerSeconds);
      
      int pacX = map(initialSeconds - timerSeconds, 0, initialSeconds, 0, 14);
      
      lcd.setCursor(0, 1);
      for (int i = 0; i < 16; i++) {
        if (i < pacX) {
          lcd.print(" "); 
        } else if (i == pacX) {
          if (mouthOpen) lcd.write(0); else lcd.write(1);
        } else if (i == 15) {
          lcd.write(3); 
        } else {
          lcd.write(2); 
        }
      }
    }
  } 
  else if (!running && !isReset) {
    // PAUSED MODE
    lcd.setCursor(0, 0);
    lcd.print("PAUSED: ");
    printPaddedTime(timerSeconds);
  }

  // end sequence
  if (running && timerSeconds <= 0) {
    finishSequence();
  }
}

// end logic
void finishSequence() {
  running = false;
  isReset = true;
  
  lcd.clear();
  lcd.setCursor(14, 1);
  lcd.write(3); 
  lcd.setCursor(13, 1);
  lcd.write(1); 
  
  for (int freq = 1000; freq > 200; freq -= 10) {
    tone(buzzerPin, freq);
    delay(15);
  }
  noTone(buzzerPin);
  
  lcd.setCursor(13, 1);
  lcd.write(4); 
  
  lcd.setCursor(0, 0);
  lcd.print("FINISHED        "); 
  delay(3000); 
}

// helpers
void printPaddedTime(long totalSecs) {
  int m = totalSecs / 60;
  int s = totalSecs % 60;
  if (m < 10) lcd.print("0");
  lcd.print(m);
  lcd.print(":");
  if (s < 10) lcd.print("0");
  lcd.print(s);
  lcd.print("   ");
}
